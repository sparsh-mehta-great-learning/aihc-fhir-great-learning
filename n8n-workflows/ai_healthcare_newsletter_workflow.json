{
  "name": "AI in Healthcare Newsletter — Dual Cadence (OpenAI Fixed)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 1 30 * * *"
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily Trigger (7AM IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 30 2 * * 1"
            }
          ]
        }
      },
      "id": "weekly-trigger",
      "name": "Weekly Trigger (Mon 8AM IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 400]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { type: 'daily' } }];"
      },
      "id": "set-daily",
      "name": "Set Daily Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 200]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { type: 'weekly' } }];"
      },
      "id": "set-weekly",
      "name": "Set Weekly Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "append"
      },
      "id": "merge",
      "name": "Merge All",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [900, 400]
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  const url = d.url || d.link || '';\n  if (!url || seen.has(url)) continue;\n  seen.add(url);\n  out.push({\n    title: d.title || 'Untitled',\n    url,\n    summary: d.summary || d.description || '',\n    source: d.source || 'Unknown',\n    publishedAt: d.publishedAt || new Date().toISOString()\n  });\n}\nout.sort((a,b)=> new Date(b.publishedAt)-new Date(a.publishedAt));\nreturn [{ json: { articles: out.slice(0,40), count: out.length, type: $input.first().json.type } }];"
      },
      "id": "process",
      "name": "Deduplicate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-4.1-mini",
        "messages": [
          {
            "role": "user",
            "content": "You are a healthcare AI newsletter editor.\n\nFrom articles, create:\n- Top 5 updates\n- Tool of the day\n- Research highlight\n- Teaching insight\n\nOutput JSON only.\n\nArticles:\n{{ JSON.stringify($json.articles) }}"
          }
        ],
        "options": {
          "temperature": 0.3
        }
      },
      "id": "openai",
      "name": "OpenAI Process",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 4.1,
      "position": [1300, 400]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.text || $json.choices?.[0]?.message?.content || '';\nlet parsed;\ntry {\n parsed = JSON.parse(raw);\n} catch(e){\n return [{json:{error:'parse fail', raw}}];\n}\nreturn [{json:{...parsed, type:$json.type}}];"
      },
      "id": "parse",
      "name": "Parse Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 400]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.type }}",
              "rightValue": "daily",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "if",
      "name": "Daily or Weekly",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1700, 400]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{subject:'Daily AI Healthcare', html:'<h1>Daily</h1>'}}];"
      },
      "id": "daily-html",
      "name": "Build Daily",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1900, 250]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{subject:'Weekly AI Healthcare', html:'<h1>Weekly</h1>'}}];"
      },
      "id": "weekly-html",
      "name": "Build Weekly",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1900, 550]
    },
    {
      "parameters": {
        "sendTo": "test@example.com",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}"
      },
      "id": "send-daily",
      "name": "Send Daily Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [2100, 250]
    },
    {
      "parameters": {
        "sendTo": "test@example.com",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}"
      },
      "id": "send-weekly",
      "name": "Send Weekly Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [2100, 550]
    }
  ],
  "connections": {
    "Daily Trigger (7AM IST)": {
      "main": [[{ "node": "Set Daily Type", "type": "main", "index": 0 }]]
    },
    "Weekly Trigger (Mon 8AM IST)": {
      "main": [[{ "node": "Set Weekly Type", "type": "main", "index": 0 }]]
    },
    "Set Daily Type": {
      "main": [[{ "node": "Merge All", "type": "main", "index": 0 }]]
    },
    "Set Weekly Type": {
      "main": [[{ "node": "Merge All", "type": "main", "index": 0 }]]
    },
    "Merge All": {
      "main": [[{ "node": "Deduplicate & Normalize", "type": "main", "index": 0 }]]
    },
    "Deduplicate & Normalize": {
      "main": [[{ "node": "OpenAI Process", "type": "main", "index": 0 }]]
    },
    "OpenAI Process": {
      "main": [[{ "node": "Parse Output", "type": "main", "index": 0 }]]
    },
    "Parse Output": {
      "main": [[{ "node": "Daily or Weekly", "type": "main", "index": 0 }]]
    },
    "Daily or Weekly": {
      "main": [
        [{ "node": "Build Daily", "type": "main", "index": 0 }],
        [{ "node": "Build Weekly", "type": "main", "index": 0 }]
      ]
    },
    "Build Daily": {
      "main": [[{ "node": "Send Daily Email", "type": "main", "index": 0 }]]
    },
    "Build Weekly": {
      "main": [[{ "node": "Send Weekly Email", "type": "main", "index": 0 }]]
    }
  }
}
